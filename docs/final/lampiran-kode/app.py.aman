from flask import Flask, request, jsonify
import html
import pymysql

app = Flask(__name__)

conf = {}
with open("/etc/iot/iot.env") as fh:
    for baris in fh:
        if "=" in baris:
            kunci, nilai = baris.strip().split("=", 1)
            conf[kunci] = nilai

DB = dict(host=conf["DB_HOST"], port=int(conf["DB_PORT"]), user=conf["DB_USER"], password=conf["DB_PASS"], database=conf["DB_NAME"])


def ambil(sql, nilai=None):
    conn = pymysql.connect(**DB)
    cur = conn.cursor()
    if nilai is None:
        cur.execute(sql)
    else:
        cur.execute(sql, nilai)
    rows = cur.fetchall()
    kolom = [d[0] for d in cur.description]
    conn.close()
    return kolom, rows


@app.route("/")
def index():
    kolom, rows = ambil("SELECT * FROM sensor_readings ORDER BY id DESC LIMIT 20")
    isi = ""
    for r in rows:
        isi += "<tr>"
        for nilai in r:
            isi += "<td>%s</td>" % html.escape(str(nilai))
        isi += "</tr>"
    kepala = "".join("<th>%s</th>" % html.escape(k) for k in kolom)
    return (
        "<h1>Dashboard IoT PBL5</h1>"
        "<p>Pembacaan sensor sprinkler peternakan sapi perah</p>"
        "<table border='1' cellpadding='6'><tr>"
        + kepala
        + "</tr>"
        + isi
        + "</table>"
    )


@app.route("/sensor")
def sensor():
    dev = request.args.get("device", "")
    kolom, rows = ambil("SELECT * FROM sensor_readings WHERE device_id = %s", (dev,))
    hasil = []
    for baris in rows:
        isi = {}
        for kunci, nilai in zip(kolom, baris):
            isi[kunci] = nilai if isinstance(nilai, (int, float)) else str(nilai)
        hasil.append(isi)
    return jsonify({"jumlah": len(hasil), "data": hasil})


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=3000, debug=False)
